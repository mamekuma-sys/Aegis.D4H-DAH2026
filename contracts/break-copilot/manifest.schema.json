{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/contracts/break-copilot/manifest.schema.json",
  "title": "Sanitized break evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "side", "raw_content_included", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "side": {"enum": ["attacker", "defender"]},
    "raw_content_included": {"const": false},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "source_name", "kind", "size_bytes", "summary"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E-[0-9a-f]{12}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_name": {"type": "string", "maxLength": 160},
          "kind": {"enum": ["pcap", "log"]},
          "size_bytes": {"type": "integer", "minimum": 0},
          "summary": {"type": "object"}
        }
      }
    }
  }
}
